<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado con ROL VISIBLE en un Chip destacado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRoleHeaderEstacion"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROL: ESTACIÓN DE MONITOREO"
                android:textColor="@color/accent_blue"
                android:textStyle="bold"
                app:chipBackgroundColor="@color/card_dark"
                app:chipStrokeColor="@color/accent_blue"
                app:chipStrokeWidth="1.5dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Indicador circular de estado de conexión -->
            <View
                android:id="@+id/viewConnectionDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/circle_status_inactive" />

            <TextView
                android:id="@+id/tvEstacionConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Desconectado"
                android:textColor="@color/md_theme_dark_onSurface"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Panel de Selección de Dispositivo Bluetooth y Conexión -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dispositivo Nodo Sensor (ESP32)"
                    android:textColor="@color/md_theme_dark_onSurfaceVariant"
                    android:textSize="12sp" />

                <!-- Selector de dispositivo emparejado -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectDevice"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Seleccionar dispositivo emparejado..."
                    android:textColor="@color/accent_blue"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/accent_blue" />

                <!-- Botones de Conectar / Desconectar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConnect"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/accent_blue"
                        android:text="Conectar"
                        android:textColor="@color/md_theme_dark_onPrimary"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDisconnect"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Desconectar"
                        android:textColor="@color/status_active"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/status_active" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Barra de Estado de Telemetría: Última actualización y advertencia de datos obsoletos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvUltimaActualizacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Esperando telemetría..."
                android:textColor="@color/md_theme_dark_onSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAlertaDesactualizado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠ Datos desactualizados (>6s)"
                android:textColor="@color/status_active"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- DASHBOARD 4 TARJETAS MATERIAL -->
        <!-- FILA 1: TEMPERATURA Y TURBIDEZ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- Tarjeta 1: Temperatura -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEstacionTemp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/card_dark"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEMPERATURA"
                        android:textColor="@color/md_theme_dark_onSurfaceVariant"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTempValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="--.- °C"
                        android:textColor="@color/accent_blue"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTempEstadoRango"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Sin datos"
                        android:textColor="@color/status_inactive"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tarjeta 2: Turbidez -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEstacionTurb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/card_dark"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TURBIDEZ"
                        android:textColor="@color/md_theme_dark_onSurfaceVariant"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTurbValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="--.- %"
                        android:textColor="@color/accent_blue"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTurbEstadoRango"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Sin datos"
                        android:textColor="@color/status_inactive"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- FILA 2: AIREADOR Y ALIMENTADOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Tarjeta 3: Aireador -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEstacionAireador"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/card_dark"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AIREADOR"
                        android:textColor="@color/md_theme_dark_onSurfaceVariant"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAireadorValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="APAGADO"
                        android:textColor="@color/status_inactive"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAireadorModoDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Modo: AUTO"
                        android:textColor="@color/accent_blue"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tarjeta 4: Alimentador -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEstacionAlimentador"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/card_dark"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ALIMENTADOR"
                        android:textColor="@color/md_theme_dark_onSurfaceVariant"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAlimentadorValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="EN ESPERA"
                        android:textColor="@color/status_inactive"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAlimentadorMensajeDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Próxima alimentación en 15 s"
                        android:textColor="@color/white"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- PANEL DE CONTROL OT (COMANDOS HACIA EL NODO) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Panel de Comandos OT (Hacia Nodo Sensor)"
            android:textColor="@color/md_theme_dark_onSurface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Botón Forzar Alimentación Inmediata -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnForzarAlimentacion"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/accent_blue"
            android:text="Forzar Alimentación Inmediata"
            android:textColor="@color/md_theme_dark_onPrimary"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

        <!-- Selector de Modo de Aireador (Auto, Manual ON, Manual OFF) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Control Remoto del Aireador:"
            android:textColor="@color/md_theme_dark_onSurfaceVariant"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAireadorAuto"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="AUTO"
                android:textColor="@color/accent_blue"
                app:cornerRadius="8dp"
                app:strokeColor="@color/accent_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAireadorOn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="MANUAL ON"
                android:textColor="@color/status_active"
                app:cornerRadius="8dp"
                app:strokeColor="@color/status_active" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAireadorOff"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="MANUAL OFF"
                android:textColor="@color/status_inactive"
                app:cornerRadius="8dp"
                app:strokeColor="@color/status_inactive" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
